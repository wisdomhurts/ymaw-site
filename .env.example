# Copy to Vercel project env vars (Settings -> Environment Variables).
# The site runs without any of these in an honest demo mode:
# registrations answer { demo: true } and store nothing.

# Supabase (project Settings -> API). Service role key stays server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers -> API keys). Use sk_test_ keys until go-live.
STRIPE_SECRET_KEY=
# Signing secret for the /api/stripe-webhook endpoint
# (Developers -> Webhooks -> add endpoint for checkout.session.completed).
STRIPE_WEBHOOK_SECRET=

# Canonical origin used in Stripe redirect URLs (no trailing slash).
PUBLIC_SITE_URL=https://ymaw.com
