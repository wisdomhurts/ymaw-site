# Copy these into Vercel → Project → Settings → Environment Variables.
# The site runs honestly without any of them: registration answers { demo: true } and stores nothing.

# Supabase (project "ymaw" → Settings → API). Service role key is server-only.
SUPABASE_URL=https://ruevenlfmqxvxorqkery.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers → API keys). sk_test_ first, sk_live_ at go-live.
STRIPE_SECRET_KEY=
# Webhook signing secret for POST /api/stripe/webhook (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=

# Resend (resend.com → API keys). Verify ymaw.com to send from info@ymaw.com.
RESEND_API_KEY=
RESEND_FROM=YMAW <info@ymaw.com>
# Where the team's notifications go (comma-separated)
NOTIFY_EMAIL=info@ymaw.com

# Google Sheet sync (Apps Script web app URL + shared secret) — optional
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# GoHighLevel (the Society's CRM / mailing list). Either pair works; API is cleaner.
#   API: Settings → Private Integrations → new token with contacts.write; Location ID from Settings → Business Profile.
GHL_API_KEY=
GHL_LOCATION_ID=
#   or a workflow "Inbound Webhook" trigger URL (fields: email, name, first_name, last_name, phone, tags, source, lists, where)
GHL_WEBHOOK_URL=

# Admin page key (/admin)
ADMIN_KEY=

# Canonical origin for links in emails and Stripe redirects
PUBLIC_SITE_URL=https://ymaw.com
